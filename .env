# ==============================================================================
# CHATAF ENVIRONMENT VARIABLES (TEMPLATE / DEFAULTS)
# Copy this to .env.local for active local development
# ==============================================================================

# Supabase Public Configuration (Browser-accessible)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-jwt
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase Server-Only Secrets (Never expose to client/browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-jwt
SUPABASE_SECRET_KEY=sb_secret_your_key_here

# Database Direct & Pooler URLs
DATABASE_URL=postgresql://postgres.your-project-ref:[PASSWORD]@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.your-project-ref.supabase.co:5432/postgres

# Vercel Daily Cron Authentication Secret
CRON_SECRET=your-random-32-byte-hex-secret

# GIPHY API Key (Server-side proxy for zero-egress GIF search)
GIPHY_API_KEY=your-giphy-api-key

# Crypto Payment Settings (BSC BEP20)
NEXT_PUBLIC_CRYPTO_WALLET_ADDRESS=0xa8f5ea9431d2e2d10cb67562155e0b83bdf8082a
NEXT_PUBLIC_CRYPTO_NETWORK="BSC (BEP20)"
